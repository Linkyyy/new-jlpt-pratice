          "label": "1",
          "text": "ずっと"
        },
        {
          "id": "B",
          "label": "2",
          "text": "しっかり"
        },
        {
          "id": "C",
          "label": "3",
          "text": "こっそり"
        },
        {
          "id": "D",
          "label": "4",
          "text": "すでに"
        }
      ],
      "correctOptionId": "C",
      "explanation": [
