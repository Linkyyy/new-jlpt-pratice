      "richText": true,
      "options": [
        {
          "id": "A",
          "label": "1",
          "text": "スープの味が薄かったので、塩を補足しました。"
        },
        {
          "id": "B",
          "label": "2",
          "text": "資料には概要しか書かれていないので、少し説明を補足します。"
