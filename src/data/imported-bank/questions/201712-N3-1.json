      "richText": true,
      "options": [
        {
          "id": "A",
          "label": "1",
          "text": "山下さんはたくさんの友人を身につけている。"
        },
        {
          "id": "B",
          "label": "2",
          "text": "今回の留学では多くの知識を身につけることができたと思う。"
