  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "kuromoji": "0.1.2",
    "tailwindcss": "^4",
    "typescript": "^5"
