{
  "name": "jlpt-practice",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/check-audio-assets.mjs && node scripts/build-bank-frequency.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "import:bank": "node scripts/import-question-bank.mjs",
    "import:exam-bank": "node scripts/import-exam-bank.mjs",
    "test:exam-bank": "node --test scripts/test-exam-bank.mjs",
    "verify:reading-images": "node --use-env-proxy scripts/verify-reading-images.mjs",
    "test:reading-images": "node --test scripts/test-verify-reading-images.mjs scripts/test-exam-bank.mjs",
    "import:listening-transcripts": "node scripts/import-listening-transcripts.mjs",
    "test:listening-transcripts": "node --test scripts/test-listening-transcripts.mjs",
    "check:bank": "node scripts/check-question-bank.mjs",
    "check:resources": "node scripts/check-bank-resources.mjs",
    "upload:audio": "node scripts/upload-r2-audio.mjs",
    "test:audio": "node --test scripts/test-audio.mjs",
    "setup:cloud": "node --env-file-if-exists=.env.local scripts/setup-cloud-backup.mjs",
    "setup:feedback": "node --env-file-if-exists=.env.local scripts/setup-question-feedback.mjs",
    "test:cloud": "node --test scripts/test-cloud-backup.mjs",
    "build:frequency": "node scripts/build-bank-frequency.mjs",
    "test:frequency": "node --test scripts/test-bank-frequency.mjs",
    "test:frequency-export": "node --test scripts/test-frequency-export.mjs scripts/test-frequency-pdf-options.mjs"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "next": "16.4.0",
    "pdfkit": "^0.20.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "kuromoji": "0.1.2",
    "opencc-js": "1.0.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
