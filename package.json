{
  "name": "jlpt-practice",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/check-audio-assets.mjs && node scripts/build-bank-frequency.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "import:bank": "node scripts/import-question-bank.mjs",
    "check:bank": "node scripts/check-question-bank.mjs",
    "check:resources": "node scripts/check-bank-resources.mjs",
    "upload:audio": "node scripts/upload-r2-audio.mjs",
